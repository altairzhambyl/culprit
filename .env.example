# ---------------------------------------------------------------------------
# Culprit configuration (copy to .env). Everything is optional except model access.
# ---------------------------------------------------------------------------

# Model provider: bedrock (default) | anthropic | openai | scripted (offline demo/tests)
CULPRIT_MODEL_PROVIDER=bedrock
# Bedrock model id (defaults to the Strands default, currently global.anthropic.claude-sonnet-4-6).
# Any Bedrock Claude model with tool use works, e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0
# CULPRIT_MODEL_ID=
CULPRIT_MODEL_TEMPERATURE=0.2
CULPRIT_MODEL_MAX_TOKENS=4096

# AWS credentials for Bedrock (or use an AWS profile / instance role / AgentCore execution role)
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# Alternative providers (require `pip install "strands-agents[anthropic]"` / `[openai]`)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Guard-rails
CULPRIT_MAX_EXPERIMENTS=10         # experiments per investigation (bisection needs ~log2(n)+3)
CULPRIT_EXPERIMENT_TIMEOUT=600     # seconds per experiment (the whole process tree is killed on timeout)
CULPRIT_MAX_TOOL_CALLS=60          # hard cap on tool calls per investigation
CULPRIT_MAX_REPEATED_CALLS=3       # identical tool calls tolerated before the loop guard cancels them
CULPRIT_APPROVAL_TOOLS=open_pull_request   # comma-separated tools that require human approval
CULPRIT_AUTO_APPROVE=false         # true = unattended mode (CI)

# Where runs, sessions, traces and reports are stored
CULPRIT_RUNS_DIR=runs

# Integrations (all optional — without them Culprit writes the PR and notification locally)
# GITHUB_TOKEN=ghp_...              # opens a real pull request (repo needs a GitHub remote)
# GITHUB_REPO=owner/name            # override remote detection
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Web dashboard
CULPRIT_HOST=127.0.0.1
CULPRIT_PORT=8000
# For a publicly hosted live demo: require a bearer token on mutating endpoints and only allow the
# bundled demo repository (arbitrary repos would let visitors run shell commands on your host).
# CULPRIT_API_TOKEN=change-me
# CULPRIT_DEMO_ONLY=true
